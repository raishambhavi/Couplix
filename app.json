{
  "expo": {
    "name": "Couplix",
    "slug": "couplix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/couplix-header-mark-transparent.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/couplix-splash-full.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "userInterfaceStyle": "dark",
      "splash": {
        "image": "./assets/couplix-splash-full.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000",
        "dark": {
          "image": "./assets/couplix-splash-full.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      },
      "bundleIdentifier": "com.raishambhavi.couplix",
      "buildNumber": "7",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSCameraUsageDescription": "Couplix needs camera access for raw Daily Snaps and Photo Drops.",
        "NSPhotoLibraryUsageDescription": "Couplix saves and shows your unfiltered photos only for you and your partner.",
        "NSLocationWhenInUseUsageDescription": "Couplix can pin memories on your shared map when you choose to add location."
      }
    },
    "android": {
      "package": "com.raishambhavi.couplix",
      "splash": {
        "image": "./assets/couplix-splash-full.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000",
        "dark": {
          "image": "./assets/couplix-splash-full.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/couplix-header-mark-transparent.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/couplix-splash-full.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "image": "./assets/couplix-splash-full.png",
            "resizeMode": "contain",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "sounds": [],
          "color": "#0B0A0F"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Couplix to access your camera for Daily Snaps.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
